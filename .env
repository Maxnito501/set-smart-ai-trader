# 🔴🔴🔴 SET SMART API (จำเป็น) 🔴🔴🔴
# ไปเอา API Key จาก SET SMART (www.setsmart.com)
# ถ้ายังไม่มี ให้ขอจาก SET SMART ก่อน
SETSMART_API_KEY=your_actual_api_key_from_setsmart_here

# 🔴 URL ของ SET SMART API (ปกติใช้ค่านี้)
SETSMART_BASE_URL=https://api.setsmart.com

# 🔴🔴🔴 LINE Messaging API (ถ้าต้องการแจ้งเตือน) 🔴🔴🔴
# ไปเอา Channel Access Token จาก LINE Developers Console
# https://developers.line.biz/console/
LINE_CHANNEL_ACCESS_TOKEN=your_actual_channel_access_token_here

# ไปเอา User ID จาก LINE Developers Console
# (ขึ้นต้นด้วย U... เช่น U1234567890abcdef)
LINE_USER_ID=your_actual_user_id_here

# 🔴🔴🔴 Database (ไม่ต้องเปลี่ยนก็ได้) 🔴🔴🔴
DB_PATH=data/setsmart.db

# 🔴🔴🔴 Environment (development หรือ production) 🔴🔴🔴
ENVIRONMENT=development
