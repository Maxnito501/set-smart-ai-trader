# 🔴 SET SMART API Configuration
SETSMART_API_KEY=YOUR_API_KEY_HERE
SETSMART_BASE_URL=https://api.setsmart.com

# 🔴 LINE Messaging API Configuration
#    ดูวิธีขอได้ที่: https://developers.line.biz/console/
LINE_CHANNEL_ACCESS_TOKEN=YOUR_CHANNEL_ACCESS_TOKEN_HERE
LINE_USER_ID=YOUR_USER_ID_HERE

# 🔴 ตำแหน่งเก็บฐานข้อมูล
DB_PATH=data/setsmart.db

# 🔴 โหมดการทำงาน (development/production)
ENVIRONMENT=development
